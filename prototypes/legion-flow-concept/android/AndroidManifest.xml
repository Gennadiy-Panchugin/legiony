<?xml version="1.0" encoding="utf-8"?>
<!-- PROTOTYPE - NOT FOR PRODUCTION -->
<!-- Question: does the Legiony prototype play well on a real phone? A WebView wrapper around the HTML build. -->
<!-- Date: 2026-10-02 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.legiony.prototype"
    android:versionCode="3"
    android:versionName="0.3-prototype">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <!-- only for the Google web fonts; the game itself runs offline from the APK assets -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Легионы"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
